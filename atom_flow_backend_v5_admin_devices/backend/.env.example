PORT=4000
JWT_SECRET=admin123

# ============================
# MongoDB (اليوزرز المسجلين بالـ Sign Up - Registration PIN)
# ============================
# ⚠️ حطي رابط الاتصال الحقيقي بتاعك هنا في ملف .env المحلي بتاعك (متسيبيهوش هنا
# في .env.example ولا في أي كود بيتراكب على GitHub) - لو الرابط ده كان متسرب قبل
# كده في server.js، غيّري باسورد الداتابيز فورًا من MongoDB Atlas


# ============================
# MQTT (نفس بيانات فيرموير الـ ESP32)
# ============================
MQTT_HOST=MQTT_HOST=86.48.2.17
MQTT_PORT=1883
MQTT_FLOW_TOPIC=sensors/flow
MQTT_STATUS_TOPIC=status/meters

# لو true: أي جهاز يبعت بيانات لأول مرة (unid مش معروف) هيتسجل تلقائي كـ "New Device"
# مفيد وقت اختبار الاتصال بالعدادات الحقيقية بسرعة
MQTT_AUTO_REGISTER=true
